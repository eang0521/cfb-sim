generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ruleset: CLASSIC (72 teams / 6 conferences, the original port) | MEGA144 (144
// teams / 12 conferences). Conference/Division/Team are shared reference data
// across every dynasty of a given ruleset, so names/codes only need to be
// unique WITHIN a ruleset -- both datasets happen to reuse some of the same
// conference codes (e.g. "B12") and team abbreviations (e.g. "ALA").
model Conference {
  id        String     @id @default(cuid())
  ruleset   String     @default("CLASSIC")
  code      String     // SEC, B10, B12, PAC, ACC, BEC (CLASSIC) / SEC, B1G, P12, ... (MEGA144)
  name      String
  divisions Division[]
  teams     Team[]

  @@unique([ruleset, code])
}

model Division {
  id           String     @id @default(cuid())
  ruleset      String     @default("CLASSIC")
  code         String     // SECE, SECW, B10E, ...
  name         String
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id])
  teams        Team[]

  @@unique([ruleset, code])
}

model Team {
  id             String   @id @default(cuid())
  ruleset        String   @default("CLASSIC")
  name           String   // abbreviation used as display name, e.g. "ALA"
  fullName       String?  // e.g. "Alabama" -- MEGA144 only, not displayed yet
  mascot         String?  // e.g. "Crimson Tide" -- MEGA144 only, not displayed yet
  conferenceId   String
  divisionId     String
  historicScore  Float?   // CLASSIC only: fixed historical-strength input (TeamPlan.Score), needs scalePrestige()
  startingPrestige Float? // MEGA144 only: given directly, used as-is (no scaling)
  conference     Conference @relation(fields: [conferenceId], references: [id])
  division       Division   @relation(fields: [divisionId], references: [id])
  players        Player[]
  teamSeasons    TeamSeason[]
  awayGames      Game[]     @relation("AwayTeam")
  homeGames      Game[]     @relation("HomeTeam")
  movesFrom      RosterMove[] @relation("MoveFrom")
  movesTo        RosterMove[] @relation("MoveTo")
  rosterSnapshots PlayerSeasonSnapshot[]

  @@unique([ruleset, name])
}

model Dynasty {
  id                 String   @id @default(cuid())
  name               String
  ruleset            String   @default("CLASSIC")
  createdAt          DateTime @default(now())
  currentSeasonNumber Int     @default(1)
  players            Player[]
  seasons            Season[]
  rosterMoves        RosterMove[]
  rosterSnapshots    PlayerSeasonSnapshot[]
}

// posGroup: QB | UT | OL | DL | LB | DB
// pos: specific position within group (e.g. UT -> RB/TE/WR)
// side: O | D
// classYear: FR | SO | JR | SR
model Player {
  id            String   @id @default(cuid())
  dynastyId     String
  teamId        String
  name          String
  posGroup      String
  pos           String
  side          String
  classYear     String
  ovr           Int
  devTrait      Int // 1 bad, 2 normal, 3 star
  devMarker     String // "-" | "" | "+" display flag, cosmetic
  recruitedSeason Int
  dynasty       Dynasty  @relation(fields: [dynastyId], references: [id])
  team          Team     @relation(fields: [teamId], references: [id])

  // Exactly one player per position group per team: QB, UT, OL, DL, LB, DB.
  @@unique([dynastyId, teamId, posGroup])
}

// A frozen copy of a team's 6-man roster as it stood for a given season --
// taken right when that season's Player rows are set (dynasty bootstrap for
// season 1, end of the offseason transition for every season after). Needed
// because Player rows are reused SLOTS (one per team+posGroup, see the
// @@unique on Player below): a slot's contents get overwritten in place as
// players age/leave/arrive, so the live Player table only ever reflects the
// CURRENT season -- this table is what makes past seasons' rosters visible
// on the team history page. Snapshots only exist from the season this
// feature shipped in onward; earlier seasons in an existing dynasty predate
// it and have no snapshot.
model PlayerSeasonSnapshot {
  id           String   @id @default(cuid())
  dynastyId    String
  seasonNumber Int
  teamId       String
  playerName   String
  posGroup     String
  pos          String
  side         String
  classYear    String
  ovr          Int
  devTrait     Int
  devMarker    String
  dynasty      Dynasty  @relation(fields: [dynastyId], references: [id])
  team         Team     @relation(fields: [teamId], references: [id])

  @@unique([dynastyId, seasonNumber, teamId, posGroup])
}

// type: GRADUATED | EARLY_DEPARTURE | TRANSFER | FRESHMAN
// One row per player who left a slot or arrived in one, for a given
// offseason transition (seasonNumber = the season they're now ENTERING --
// so a graduate leaving after season 3 to make room for season 4 is logged
// with seasonNumber=4). fromTeamId is null for freshmen (came from high
// school); toTeamId is null for graduations/early departures (left the sport).
model RosterMove {
  id           String   @id @default(cuid())
  dynastyId    String
  seasonNumber Int
  type         String
  posGroup     String
  playerName   String
  ovr          Int
  devTrait     Int
  fromTeamId   String?
  toTeamId     String?
  dynasty      Dynasty  @relation(fields: [dynastyId], references: [id])
  fromTeam     Team?    @relation("MoveFrom", fields: [fromTeamId], references: [id])
  toTeam       Team?    @relation("MoveTo", fields: [toTeamId], references: [id])
}

// status: SCHEDULED | IN_PROGRESS | POSTSEASON | COMPLETE
model Season {
  id          String       @id @default(cuid())
  dynastyId   String
  number      Int
  status      String       @default("SCHEDULED")
  currentWeek Int          @default(1)
  dynasty     Dynasty      @relation(fields: [dynastyId], references: [id])
  teamSeasons TeamSeason[]
  games       Game[]

  @@unique([dynastyId, number])
}

model TeamSeason {
  id          String  @id @default(cuid())
  seasonId    String
  teamId      String
  prestige    Float
  offRating   Int
  defRating   Int
  totalRating Int
  rating      Int
  powerElo    Float
  wins        Int     @default(0)
  losses      Int     @default(0)
  confWins    Int     @default(0)
  confLosses  Int     @default(0)
  rank        Int?
  playoffSeed Int? // 1-6 (CLASSIC) or 1-12 (MEGA144) once the playoff field is selected; null otherwise.
  // Decided once (right after conference championships) and never recomputed --
  // national rank keeps moving as later playoff/bowl games are played, so this
  // must be persisted rather than re-derived from "current" standings.
  season      Season  @relation(fields: [seasonId], references: [id])
  team        Team    @relation(fields: [teamId], references: [id])

  @@unique([seasonId, teamId])
}

// round: REGULAR | CONF_CHAMPIONSHIP | QUARTERFINAL | SEMIFINAL | FINAL | BOWL
model Game {
  id            String  @id @default(cuid())
  seasonId      String
  week          Int
  round         String  @default("REGULAR")
  bowlName      String? // set only when round = BOWL
  neutralSite   Boolean @default(false) // true for every postseason game (no home-field edge)
  awayTeamId    String
  homeTeamId    String
  awayScore     Int?
  homeScore     Int?
  otPeriods     Int     @default(0)
  eloChangeAway Float?
  eloChangeHome Float?
  played        Boolean @default(false)
  // National rank as of right before this game was simulated (null if
  // unranked/untracked, e.g. the FCS team) -- snapshotted at simulation time
  // since a team's live `rank` keeps moving in later weeks, so it can't be
  // recovered afterward from current standings alone.
  awayRankEntering Int?
  homeRankEntering Int?
  // Overall win-loss record immediately after this game's result was applied.
  awayWinsAfter    Int?
  awayLossesAfter  Int?
  homeWinsAfter    Int?
  homeLossesAfter  Int?
  season        Season  @relation(fields: [seasonId], references: [id])
  awayTeam      Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam      Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
}
